# ---------------------------------------------------------------------------
# Development image — runs `next dev` with hot module replacement. Source
# code is bind-mounted in docker-compose.dev.yml, so edits on your machine
# are reflected instantly inside the container.
# ---------------------------------------------------------------------------
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["npm", "run", "dev"]
